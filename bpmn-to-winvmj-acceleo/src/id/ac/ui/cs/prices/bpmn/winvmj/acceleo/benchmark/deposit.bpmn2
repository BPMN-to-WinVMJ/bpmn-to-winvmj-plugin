    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_9" name="currency equals (&quot;JPY&quot;)" sourceRef="Gateway_Currency" targetRef="Task_Mult3">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="FormalExpression_3">currency == &quot;JPY&quot;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
