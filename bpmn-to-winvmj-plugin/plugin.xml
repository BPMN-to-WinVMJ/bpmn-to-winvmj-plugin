<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension-point id="bpmn.to.winvmj.plugin.extension" name="BPMN to WinVMJ Extension" schema="schema/bpmn.to.winvmj.plugin.exsd"/>

   <extension point="org.eclipse.ui.commands">
      <command
            id="bpmn.to.winvmj.plugin.commands.convert"
            name="Convert BPMN to WinVMJ"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="bpmn.to.winvmj.plugin.commands.convert"
            class="id.ac.ui.cs.prices.bpmn.winvmj.handler.OpenConverterHandler">
         <!-- Only activate handler when selection is a .bpmn2 file -->
         <activeWhen>
            <with variable="selection">
               <iterate ifEmpty="false">
                  <adapt type="org.eclipse.core.resources.IFile">
                     <test
                           property="org.eclipse.core.resources.extension"
                           value="bpmn2"/>
                  </adapt>
               </iterate>
            </with>
         </activeWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="bpmn.to.winvmj.plugin.commands.convert"
               id="bpmn.to.winvmj.plugin.menus.convertCommand"
               label="Convert BPMN to WinVMJ"
               icon="icons/burhan.png"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IFile">
                        <test
                              property="org.eclipse.core.resources.extension"
                              value="bpmn2"/>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
</plugin>
